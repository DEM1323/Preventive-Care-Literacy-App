# Server-only local development values. Never expose these through VITE_* names.
DATABASE_URL=postgresql://restricted-runtime-role:password@localhost:5432/prevcare
# Set this to the Supabase server root certificate PEM in hosted environments.
DATABASE_CA_CERT=
PUBLIC_ORIGIN=http://localhost:3000
OPERATOR_PROVISIONING_TOKEN=replace-with-at-least-32-random-characters
OPERATOR_ID=local-technical-operator
INVITATION_HMAC_KEY=base64-encoded-32-byte-key
INVITATION_DELIVERY_KEY_ID=staging-2026-01
INVITATION_DELIVERY_KEY=base64-encoded-32-byte-key
APPLICATION_WRAPPING_KEY_ID=staging-2026-01
APPLICATION_WRAPPING_KEY=base64-encoded-32-byte-key
APPLICATION_IDEMPOTENCY_KEY=base64-encoded-32-byte-key

# Supabase staff authentication seam. The web service requires these; browsers
# never receive Supabase credentials or tokens.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-secret-key

# Optional values for running provider checks manually.
SUPABASE_PROJECT_REF=project-ref
SUPABASE_STORAGE_BUCKET=private-records
SUPABASE_QUEUE_NAME=provider-smoke
SUPABASE_CRON_JOB_NAME=provider-smoke
RESEND_API_KEY=replace-with-resend-api-key
INVITATION_EMAIL_FROM=Invitation <verified-sender@example.test>
# Optional staging/golden-journey safety control. When set, Invitation
# delivery fails closed for any other recipient. When omitted, the Resend
# adapter delivers a neutral Invitation Code to any validated recipient.
INVITATION_CONTROLLED_MAILBOX=controlled-mailbox@example.test
# Private Railway worker only. Use a dedicated role granted only the narrow
# invitation delivery functions by scripts/migrate-staging.ts.
WORKER_DATABASE_URL=postgresql://restricted-worker-role:password@localhost:5432/prevcare
PROVIDER_SMOKE_EMAIL=controlled-mailbox@example.test
PROVIDER_SMOKE_EMAIL_FROM=Staging <verified-sender@example.test>
PROVIDER_SMOKE_AUTH_EMAIL=auth-smoke@example.test
PROVIDER_SMOKE_AUTH_PASSWORD=replace-with-auth-smoke-password
PROVIDER_SMOKE_AUTH_TOTP_SECRET=replace-with-base32-totp-secret
